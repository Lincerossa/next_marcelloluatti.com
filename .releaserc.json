{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
    "@semantic-release/github",
    {
      "assets": ["${nextRelease.gitTag}"],
      "releaseType": "push",
      "repo": "https://github.com/Lincerossa/next_marcelloluatti.com.git",
      "token": "${GITHUB_TOKEN}"
    }
    ]
  ]
}